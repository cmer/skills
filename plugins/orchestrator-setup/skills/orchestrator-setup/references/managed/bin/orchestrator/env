#!/usr/bin/env sh
# Managed by the orchestrator-setup skill (layout 2). Do not edit this file:
# project settings live in bin/orchestrator/config, and orchestrator support
# lives in bin/orchestrator/adapters/. The skill replaces this file wholesale.
#
# Source this file from scripts that need workspace isolation details. It is
# the single source of truth for workspace detection; never duplicate
# orchestrator detection logic elsewhere.
#
# Every orchestrator is one adapter file, bin/orchestrator/adapters/<id>.sh,
# defining the same functions (see the adapter contract below). The generic
# functions here ask each enabled adapter in ORCHESTRATOR_ADAPTERS order, so
# adding an orchestrator never changes another one's code.
#
# `workspace_name` reads exactly what config/database.yml reads, in the same
# order — the project env var, then tmp/WORKSPACE_NAME — so a shell script and
# Rails can never resolve different databases. Orchestrator name vars and the
# directory name belong to `workspace_setup_name`, and reach Rails only by
# being persisted to the file.

ORCHESTRATOR_LAYOUT=2

# --- Locate bin/orchestrator ------------------------------------------------
# Executables set ORCHESTRATOR_DIR before sourcing; scripts sourcing from the
# checkout root find it relative; anything else asks git.

if [ -z "${ORCHESTRATOR_DIR:-}" ]; then
  if [ -f bin/orchestrator/config ]; then
    ORCHESTRATOR_DIR=bin/orchestrator
  else
    ORCHESTRATOR_DIR="$(git rev-parse --show-toplevel 2>/dev/null)/bin/orchestrator"
  fi
fi

if [ ! -f "$ORCHESTRATOR_DIR/config" ]; then
  echo "bin/orchestrator/env: missing $ORCHESTRATOR_DIR/config" >&2
  return 1 2>/dev/null || exit 1
fi
. "$ORCHESTRATOR_DIR/config"

: "${ORCHESTRATOR_PROJECT:?set ORCHESTRATOR_PROJECT in bin/orchestrator/config}"
: "${ORCHESTRATOR_DATABASE_SCHEME:=env-file}"
: "${ORCHESTRATOR_DEFAULT_PORT:=3000}"
: "${ORCHESTRATOR_PORT_LABELS:=Rails}"
: "${ORCHESTRATOR_ADAPTERS:=}"
: "${ORCHESTRATOR_WORKSPACE_ENV:=ORCHESTRATOR_WORKSPACE_NAME}"

case "${ORCHESTRATOR_WORKSPACE_ENV:-}" in
  "" | [0-9]* | *[!A-Za-z0-9_]*)
    echo "bin/orchestrator/config: ORCHESTRATOR_WORKSPACE_ENV must be a shell variable name" >&2
    return 1 2>/dev/null || exit 1
    ;;
esac

for orchestrator_adapter in $ORCHESTRATOR_ADAPTERS; do
  if [ ! -f "$ORCHESTRATOR_DIR/adapters/$orchestrator_adapter.sh" ]; then
    echo "bin/orchestrator/env: no adapter for '$orchestrator_adapter'" >&2
    return 1 2>/dev/null || exit 1
  fi
  . "$ORCHESTRATOR_DIR/adapters/$orchestrator_adapter.sh"
done
unset orchestrator_adapter

# --- Adapter contract -------------------------------------------------------
# Each adapters/<id>.sh defines, for its <id>:
#
#   orchestrator_<id>_detected      true when this orchestrator is active
#   orchestrator_<id>_path          print the workspace root, or return 1
#   orchestrator_<id>_name          print the tool's workspace name, or return 1
#   orchestrator_<id>_port          print a tool-provided port, or return 1
#   orchestrator_<id>_main_checkout print the main checkout path, or return 1
#   orchestrator_<id>_in_main_checkout
#                                   true when this context is known to be the
#                                   main checkout (it must not get a name)
#   orchestrator_<id>_traits        print zero or more of:
#                                     allocate-ports    project allocates a 10-port block
#                                     port-labels       tool reads .superset/ports.json
#                                     worktree-include  tool ignores .worktreeinclude
#                                     discover-port     find a running puma when no port is given
#
# Each function must look only at its own orchestrator's variables.

# Prints the first value an adapter function yields, in adapter order.
orchestrator_first() {
  for orchestrator_id in $ORCHESTRATOR_ADAPTERS; do
    if orchestrator_value="$("orchestrator_${orchestrator_id}_$1" 2>/dev/null)" && [ -n "$orchestrator_value" ]; then
      printf '%s\n' "$orchestrator_value"
      return 0
    fi
  done
  return 1
}

# True if any active adapter satisfies the given adapter function.
orchestrator_any() {
  for orchestrator_id in $ORCHESTRATOR_ADAPTERS; do
    if "orchestrator_${orchestrator_id}_detected" && "orchestrator_${orchestrator_id}_$1"; then
      return 0
    fi
  done
  return 1
}

# True if any active adapter has the trait.
workspace_has_trait() {
  for orchestrator_id in $ORCHESTRATOR_ADAPTERS; do
    if "orchestrator_${orchestrator_id}_detected"; then
      case " $("orchestrator_${orchestrator_id}_traits") " in
        *" $1 "*) return 0 ;;
      esac
    fi
  done
  return 1
}

# Prints the id of the first active adapter.
workspace_active_orchestrator() {
  for orchestrator_id in $ORCHESTRATOR_ADAPTERS; do
    if "orchestrator_${orchestrator_id}_detected"; then
      printf '%s\n' "$orchestrator_id"
      return 0
    fi
  done
  return 1
}

# --- Workspace name file ----------------------------------------------------

workspace_name_file() {
  eval "orchestrator_name_file=\${${ORCHESTRATOR_WORKSPACE_ENV}_FILE:-tmp/WORKSPACE_NAME}"
  printf '%s\n' "$orchestrator_name_file"
}

read_persisted_workspace_name() {
  file="$(workspace_name_file)"
  [ -f "$file" ] || return 1

  name="$(sed -n '1p' "$file")"
  [ -n "$name" ] || return 1
  printf '%s\n' "$name"
}

# --- Workspace name from environment ----------------------------------------
# The project's own var, and only it: config/database.yml reads this same var.

workspace_env_name() {
  eval "orchestrator_env_value=\${${ORCHESTRATOR_WORKSPACE_ENV}:-}"
  [ -n "$orchestrator_env_value" ] || return 1
  printf '%s\n' "$orchestrator_env_value"
}

# --- Workspace name from the orchestrator -----------------------------------
# Setup-time input only — Rails never sees these.

workspace_orchestrator_name() {
  orchestrator_first name
}

# --- Orchestrator detection -------------------------------------------------

workspace_detection_present() {
  workspace_active_orchestrator >/dev/null
}

# --- Workspace name resolution ----------------------------------------------
# What every reader uses: the project env var, then the persisted file. Same
# two sources, same order, as config/database.yml.

workspace_name() {
  workspace_env_name || read_persisted_workspace_name
}

# --- Workspace name for setup -----------------------------------------------
# What setup and teardown use, and nothing else. Adds the orchestrator's name,
# then the directory name for tools that name no workspace. Both outrank the
# persisted file: at setup time the orchestrator's vars are the fresh truth,
# and the file may be a leftover from an earlier or aborted workspace.
#
# A checkout an orchestrator merely detects (the main repo opened in the tool)
# is not a workspace until setup names it; adapters that can tell say so via
# orchestrator_<id>_in_main_checkout, and it keeps the shared database.

workspace_setup_name() {
  workspace_env_name ||
    workspace_orchestrator_name ||
    read_persisted_workspace_name ||
    { workspace_detection_present && ! orchestrator_any in_main_checkout && basename "$PWD"; }
}

workspace_managed() {
  workspace_name >/dev/null 2>&1
}

# --- Capabilities -----------------------------------------------------------

workspace_needs_port_allocation() {
  workspace_has_trait allocate-ports
}

workspace_wants_port_labels() {
  workspace_has_trait port-labels
}

workspace_needs_worktree_include_copy() {
  workspace_has_trait worktree-include
}

# Prints a port the orchestrator assigned, if any. Asked of every enabled
# adapter whether or not it is detected: a port var alone is enough.

workspace_tool_port() {
  orchestrator_first port
}

# --- Paths ------------------------------------------------------------------
# Port allocations are keyed by workspace_path, so an adapter must return the
# same string in every context it supports.

workspace_path() {
  orchestrator_first path || printf '%s\n' "$PWD"
}

# The main checkout: the copy source for .worktreeinclude. The first entry of
# `git worktree list` is always the main worktree.

workspace_main_checkout_path() {
  orchestrator_first main_checkout && return 0
  main="$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')"
  [ -n "$main" ] || return 1
  printf '%s\n' "$main"
}

# --- Database naming (env-file scheme) --------------------------------------
# Pattern: <project>_<workspace>_<environment>, or <project>_<environment>.
# With the worktree-folder scheme, ask Rails/database.yml instead.

workspace_database_prefix() {
  if name="$(workspace_name 2>/dev/null)"; then
    printf '%s_%s\n' "$ORCHESTRATOR_PROJECT" "$name"
  else
    printf '%s\n' "$ORCHESTRATOR_PROJECT"
  fi
}

workspace_database_name() {
  environment="${1:?Usage: workspace_database_name ENVIRONMENT}"
  printf '%s_%s\n' "$(workspace_database_prefix)" "$environment"
}

# --- Persistence ------------------------------------------------------------
# Always (re)writes the freshly resolved name: the file is a cache, and a file
# left by an earlier or aborted workspace must not name the new one.

persist_workspace_name() {
  name="$(workspace_setup_name 2>/dev/null || true)"
  [ -n "$name" ] || return 1

  file="$(workspace_name_file)"
  mkdir -p "$(dirname "$file")"
  printf '%s\n' "$name" > "$file"
  printf '%s\n' "$name"
}

# --- Lifecycle steps --------------------------------------------------------
# Called by the project's own bin/orchestrator/setup and teardown, from the
# checkout root.

# Copies .worktreeinclude files, resolves and exports the workspace name
# (env-file scheme), and allocates the port block. Sets $workspace_name.
workspace_prepare_setup() {
  if workspace_needs_worktree_include_copy; then
    echo "Copying .worktreeinclude files from the main checkout..."
    "$ORCHESTRATOR_DIR/worktree-include"
  fi

  workspace_name=""
  if [ "$ORCHESTRATOR_DATABASE_SCHEME" = env-file ]; then
    workspace_name="$(persist_workspace_name 2>/dev/null || true)"
    if [ -z "$workspace_name" ] && workspace_detection_present; then
      echo "ERROR: running inside an orchestrator but could not resolve the workspace name." >&2
      echo "Refusing to set up the shared database from a managed worktree." >&2
      exit 1
    fi
    if [ -n "$workspace_name" ]; then
      export "$ORCHESTRATOR_WORKSPACE_ENV=$workspace_name"
    fi
  fi

  if workspace_needs_port_allocation; then
    echo "Reserving workspace ports..."
    "$ORCHESTRATOR_DIR/port" allocate >/dev/null
  fi
}

# Returns 0 when the workspace databases should be dropped (with the env var
# exported for the env-file scheme), 1 when there is nothing to drop. Exits
# when dropping would hit the shared databases or orphan the workspace's.
workspace_begin_teardown() {
  if [ "$ORCHESTRATOR_DATABASE_SCHEME" = none ]; then
    return 1
  fi

  if [ "$ORCHESTRATOR_DATABASE_SCHEME" = worktree-folder ]; then
    if [ -d .git ]; then
      echo "ERROR: .git is a directory, so this appears to be the main checkout." >&2
      echo "Refusing to drop the primary development/test databases." >&2
      exit 1
    fi
    echo "Dropping databases for this git worktree..."
    return 0
  fi

  # Resolves the way setup did, so teardown drops exactly what setup created,
  # even when tmp/WORKSPACE_NAME is already gone.
  workspace_name="$(workspace_setup_name 2>/dev/null || true)"
  if [ -z "$workspace_name" ] && workspace_detection_present; then
    echo "ERROR: running inside an orchestrator but could not resolve the workspace name." >&2
    echo "Refusing to tear down: workspace databases would be left orphaned." >&2
    exit 1
  fi
  if [ -z "$workspace_name" ]; then
    echo "Workspace name not set; skipping database teardown."
    return 1
  fi
  export "$ORCHESTRATOR_WORKSPACE_ENV=$workspace_name"
  echo "Dropping databases for workspace: $workspace_name"
  return 0
}

# Releases the port block. Warns instead of failing.
workspace_finish_teardown() {
  if workspace_needs_port_allocation; then
    echo "Releasing workspace ports..."
    if ! "$ORCHESTRATOR_DIR/port" release; then
      echo "Warning: failed to release workspace ports; continuing." >&2
    fi
  fi
}
